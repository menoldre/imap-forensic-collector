# imap-forensic-collector configuration
#
# Comments: both '#' and ';' start a comment, including at the end of a value line.
# Consequence: a value that itself contains '#' or ';' (e.g. a folder named
# "Projects #3") will be truncated at that character; quoting does not help.
# For such folder names use the --folders command-line option instead.

[source]
host = mail.b.hostedemail.com
port = 993
user = custodian@example.com
# password is read from the IMAP_PASSWORD env var, or prompted via getpass if unset

[collection]
# {user} = the mailbox login above, {date} = UTC run date (YYYY-MM-DD)
# e.g. ./collection_{user}  or  E:\Cases\2026-0042\{user}  or  ./{user}_{date}
output_dir = ./collection_{user}
folders = ALL          # or comma-separated list of IMAP folder names
examiner = J. Smith
case_id = 2026-0042
