# Evidence and fixture files must be stored and checked out byte-for-byte.
# Never let git normalize line endings in anything whose hash matters.
*.eml            binary
*.tar.gz         binary
*.sha256         -text
testdata/**      -text
collection.log   -text
manifest.csv     -text
failures.csv     -text

# Source files: normalize to LF in the repo.
*.py             text eol=lf
*.md             text eol=lf
*.ini            text eol=lf
*.yml            text eol=lf
*.conf           text eol=lf
.gitignore       text eol=lf
.gitattributes   text eol=lf
